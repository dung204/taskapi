root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go and its module files use tabs (gofmt).
[*.go]
indent_style = tab

[{go.mod,go.sum}]
indent_style = tab

# make REQUIRES tabs in recipes.
[{Makefile,*.mk}]
indent_style = tab

# Trailing double spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
