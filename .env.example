# number, default is 8080
PORT=8080

# memory | postgres, default is memory
TASKS_STORE=memory

# must not be empty, the format is as below
DATABASE_URL=postgres://username:password@host:port/db_name?sslmode=disable

# text | json, default is text
LOG_FORMAT=text

# debug | info | warn | error, default is info
LOG_LEVEL=info

# true | false, default is true
OVERDUE_SCAN_WORKER_ENABLED=true

# example: 30s, 1m, 500ms, default is 30s
OVERDUE_SCAN_WORKER_INTERVAL=30s

# pprof address, example: ":6060", "127.0.0.1:6060"
PPROF_ADDR=:6060

# ops (health & Prometheus) address, example: ":9091", "127.0.0.1:9091"
OPS_ADDR=127.0.0.1:9091

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# requests per second allowed for each client, refilled continuously
# allow float values (e.g. 0.5), set to "0" to disable rate limiting
RATE_LIMIT_RPS=10

# how many requests a client can make at once before being limited to RATE_LIMIT_RPS
# must be at least 1, won't be checked if rate limiting is disabled (RATE_LIMIT_RPS=0)
RATE_LIMIT_BURST=20

# Origins allowed to call the API from a browser (CORS), separated by commas.
# Each origin is `scheme://host[:port]`, without a path or a trailing slash,
# for example: https://app.example.com,http://localhost:5173
# Use `*` to allow any origin. It cannot be combined with other entries.
# Leave empty to disable CORS: browsers then only allow same-origin requests.
CORS_ALLOWED_ORIGINS=

# How long browsers may cache the result of a CORS preflight request.
# Sent as the `Access-Control-Max-Age` header. Only used when CORS_ALLOWED_ORIGINS is set.
# Accepts a Go duration in whole seconds, such as 30s, 10m or 1h. Negative values are rejected.
# Browsers cap this value (Chrome at 2h), so larger values have no extra effect.
# Set to 0 to omit the header, so browsers fall back to their own default (about 5s).
# Default: 10m.
CORS_MAX_AGE=10m

# Base URL that the links in verification and password-reset emails point at.
# A bare `scheme://host[:port]` origin, without a path or a trailing slash,
# for example: https://app.example.com
# Default: http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Redis connection URL, for default user, user can be omitted
REDIS_URL=redis://user:password@host:port/db

# Path to the Ed25519 private key used to sign access tokens (JWT, EdDSA).
# Generate the key pair with `go run ./cmd/keygen`. Keep the private key secret and out of git.
JWT_PRIVATE_KEY_PATH=secrets/jwt_ed25519.key

# Path to the matching Ed25519 public key, used to verify access tokens.
JWT_PUBLIC_KEY_PATH=secrets/jwt_ed25519.pub

# Value of the `iss` claim: who issues the tokens. Tokens with another issuer are rejected.
# Any stable string that identifies this API, usually its base URL or a short name,
# for example: https://api.example.com or taskapi
JWT_ISSUER=taskapi

# Values of the `aud` claim: who the tokens are meant for, separated by commas.
# New tokens carry all of them. A token is accepted if it has at least one of them,
# any other audience is rejected, so a value can be retired without logging everyone out.
# Each entry is any stable string that identifies a consumer, often the API itself or a client app,
# for example: https://api.example.com,taskapi-clients
JWT_AUDIENCES=taskapi-clients

# Lifetime of an access token. Keep it short, since a JWT cannot be revoked before it expires.
# Go duration, example: 5m, 10m, 1h, default is 10m
ACCESS_TTL=10m

# Lifetime of a refresh token (and so of a login session before the user has to sign in again).
# Go duration, which has no day unit: write days as hours, example: 720h (30 days), default is 720h
REFRESH_TTL=720h
# The previous refresh token is still accepted this long after a rotation (two tabs refreshing at once).
REFRESH_GRACE_PERIOD=15s

# Lifetime of the link in a verification email. After this long the user has to ask for a new one.
# Go duration, example: 1h, 24h, 48h, default is 24h
VERIFY_EMAIL_TOKEN_TTL=24h

# Lifetime of the link in a password-reset email. Keep it short, since the link lets
# whoever holds it set a new password. Go duration, example: 15m, 1h, default is 1h
RESET_PASSWORD_TOKEN_TTL=1h

# Argon2id password hashing. The defaults below are the second recommended
# parameter set of RFC 9106 (section 4): t=3, m=64 MiB, p=4.
# Raising them makes password cracking harder but every login/register slower and hungrier.

# Number of passes over the memory (the "t" parameter). Must be at least 1.
ARGON2_TIME=3

# Memory used by one hash, in KiB (the "m" parameter). 65536 KiB = 64 MiB.
# Must be at least 8 * ARGON2_THREADS.
ARGON2_MEMORY_KIB=65536

# Degree of parallelism (the "p" parameter), the number of lanes of one hash. Must be at least 1.
# Changing it changes the hash output, so keep it the same for the lifetime of your stored hashes.
ARGON2_THREADS=4

# Maximum number of hashes computed at the same time, extra requests wait for a free slot.
# This caps the memory the API spends on hashing: peak = ARGON2_CONCURRENCY * ARGON2_MEMORY_KIB
# (default settings: 64 MiB per hash). Must be at least 1, example: 2
# Default: the number of CPU cores available to the API divided by ARGON2_THREADS, but at least 1.
ARGON2_CONCURRENCY=2

# Login limiter, per email address (stored in Redis). A wrong password counts as an attempt,
# a right one resets the counter. While an address is locked, even the right password
# is answered with 429 and a Retry-After header.

# Failed logins allowed before the first lock. Must be at least 1, default is 4.
LOGIN_FREE_ATTEMPTS=4

# How long the address is locked after each further failed login: the first failure past
# LOGIN_FREE_ATTEMPTS locks it for the first value, the next for the second, and so on.
# The last value is used for every failure after that.
# Comma-separated Go durations in whole milliseconds, at least 1ms. Default is 30s,1m,5m,15m
LOGIN_BACKOFF=30s,1m,5m,15m

# How long the failed-login counter is kept, renewed by every attempt. After this long
# without an attempt the address starts again from LOGIN_FREE_ATTEMPTS.
# Must be at least the longest LOGIN_BACKOFF step. Go duration, default is 1h
LOGIN_WINDOW=1h

# Limits on emails sent on request (verification and password reset), per email address,
# stored in Redis. Over the limit the endpoint answers 429 and a Retry-After header.

# Minimum time between two requests for the same address.
# Go duration in whole milliseconds, at least 1ms, default is 60s
MAIL_REQUEST_COOLDOWN=60s

# Most requests allowed for the same address in one hour. Must be at least 1, default is 5.
MAIL_REQUEST_HOURLY_MAX=5

# Email outbox worker. Emails are queued first and a worker sends them in batches.

# How long a worker owns a batch it has claimed. After this long another worker may take
# the items again, so it must outlast the worst case of a batch: every email taking the full
# OUTBOX_SEND_TIMEOUT, one after the other. Must be greater than
# OUTBOX_BATCH_SIZE * OUTBOX_SEND_TIMEOUT, otherwise the server refuses to start.
# Positive Go duration, example: 2m, 5m, 10m, default is 5m
OUTBOX_LEASE=5m

# Most emails claimed and sent in one batch. Must be at least 1, default is 5.
OUTBOX_BATCH_SIZE=5

# Time limit for sending one email of a batch.
# Positive Go duration, example: 10s, 30s, 1m, default is 30s
OUTBOX_SEND_TIMEOUT=30s

# How often the worker looks for queued emails on its own. Normally it is woken up as soon as
# an email is queued, so this is only the safety net for a missed notification (or an email
# whose retry time has come). Smaller values deliver such emails sooner at the price of more
# queries. Positive Go duration, example: 5s, 30s, 1m, default is 30s
OUTBOX_POLL_INTERVAL=30s

# Retry policy for an email that could not be sent.

# Most times one email is tried, the first try included. After the last failed try the email
# is marked as failed and not sent again. Set to 1 to never retry. Must be at least 1, default is 6.
OUTBOX_MAX_ATTEMPTS=6

# Wait before the first retry. Each further retry waits longer, up to OUTBOX_RETRY_CAP.
# Positive Go duration, example: 30s, 1m, 5m, default is 1m
OUTBOX_RETRY_BASE=1m

# Longest wait between two tries, whatever the number of failures so far.
# Must be at least OUTBOX_RETRY_BASE, otherwise the server refuses to start.
# Positive Go duration, example: 5m, 15m, 1h, default is 15m
OUTBOX_RETRY_CAP=15m

# How long a sent email stays in the outbox before it is deleted. Keeping it for a while
# lets you check what was sent and when. Go duration, which has no day unit: write days as hours,
# example: 24h, 168h (7 days), 720h (30 days), default is 168h
OUTBOX_SENT_RETENTION=168h

# How often the cleanup job runs. It deletes data that is past its retention, such as
# sent emails older than OUTBOX_SENT_RETENTION. A longer interval means old rows stay
# a little longer than their retention, a shorter one runs the delete queries more often.
# Positive Go duration, example: 10m, 1h, 6h, default is 1h
CLEANUP_INTERVAL=1h

# SMTP server that sends the emails (verification and password reset).

# Host name of the SMTP server. Must not be empty.
SMTP_HOST=localhost

# Port of the SMTP server, 1-65535. Default is 587 (submission with STARTTLS).
# A local mail catcher such as Mailpit or MailHog usually listens on 1025.
SMTP_PORT=1025

# starttls | opportunistic | none, default is starttls
# starttls: upgrade to TLS and fail if the server does not support it
# opportunistic: upgrade to TLS when the server supports it, otherwise send in plain text
# none: never use TLS, only for a local mail catcher
SMTP_TLS_MODE=none

# Time limit for connecting to the server and sending one email.
# Positive Go duration, example: 5s, 10s, 1m, default is 10s
SMTP_TIMEOUT=10s

# Credentials for SMTP authentication (the method is discovered from the server).
# Set both or leave both empty to send without authentication.
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender of the emails, either a bare address or with a display name.
# Must not be empty, example: taskapi@example.com or Task API <taskapi@example.com>
SMTP_FROM=Task API <taskapi@no-reply.com>

# for testing purposes
TEST_DATABASE_URL=postgres://username:password@host:port/db_name?sslmode=disable
TEST_REDIS_URL=redis://127.0.0.1:6390/0
