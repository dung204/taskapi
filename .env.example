# number, default is 8080
PORT=8080

# memory | postgres, default is memory
STORE=memory

# when STORE=postgres, this must not be empty, the format is as below
DATABASE_URL=postgres://username:password@host:port/db_name?sslmode=disable

# text | json, default is text
LOG_FORMAT=text

# debug | info | warn | error, default is info
LOG_LEVEL=info

# true | false, default is true
WORKER_ENABLED=true

# example: 30s, 1m, 500ms, default is 30s
WORKER_INTERVAL=30s

# pprof address, example: ":6060", "127.0.0.1:6060"
PPROF_ADDR=:6060

# ops (health & Prometheus) address, example: ":9091", "127.0.0.1:9091"
OPS_ADDR=127.0.0.1:9091

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# requests per second allowed for each client, refilled continuously
# allow float values (e.g. 0.5), set to "0" to disable rate limiting
RATE_LIMIT_RPS=10

# how many requests a client can make at once before being limited to RATE_LIMIT_RPS
# must be at least 1, won't be checked if rate limiting is disabled (RATE_LIMIT_RPS=0)
RATE_LIMIT_BURST=20

# Origins allowed to call the API from a browser (CORS), separated by commas.
# Each origin is `scheme://host[:port]`, without a path or a trailing slash,
# for example: https://app.example.com,http://localhost:5173
# Use `*` to allow any origin. It cannot be combined with other entries.
# Leave empty to disable CORS: browsers then only allow same-origin requests.
CORS_ALLOWED_ORIGINS=

# How long browsers may cache the result of a CORS preflight request.
# Sent as the `Access-Control-Max-Age` header. Only used when CORS_ALLOWED_ORIGINS is set.
# Accepts a Go duration in whole seconds, such as 30s, 10m or 1h. Negative values are rejected.
# Browsers cap this value (Chrome at 2h), so larger values have no extra effect.
# Set to 0 to omit the header, so browsers fall back to their own default (about 5s).
# Default: 10m.
CORS_MAX_AGE=10m

# for testing purposes, not constrained to STORE
TEST_DATABASE_URL=postgres://username:password@host:port/db_name?sslmode=disable
